/*
 * Apple Silicon: -profile conda,macos_docker. See the comment above the profile in nextflow.config.
 */
docker.enabled    = true
docker.runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}"
process {
    withName: '!.*(VEP_ANNOTATE|DELLY_CALL)' {
        container = null
    }
    withName: '.*VEP_ANNOTATE' {
        container = 'ensemblorg/ensembl-vep:release_116.2@sha256:5c57abdc40b637cac198370b4c114777fa24de3336141fdf09d2b0c43cd4b8da'
        conda     = null
    }
    withName: '.*DELLY_CALL' {
        container = 'mva-track2/delly:2.6.0'
        conda     = null
    }
}

