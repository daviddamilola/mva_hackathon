/*
 * Stub/test profile: synthetic inputs only, no subject data, no downloads.
 * Run with:  nextflow run . -profile stub -stub-run
 * Uses its own work dir so stub outputs can never be resumed into a real run.
 */

params {
    sample_id      = 'SYNTHETIC'
    vcf            = "${projectDir}/tests/stub/synthetic_contigs.header"
    lanes          = "${projectDir}/tests/stub/lanes.csv"
    ref_mask_bed   = "${projectDir}/assets/grch38_grc_exclusions_v2_inferred.bed"
    reference_dir  = "${projectDir}/tests/stub/work/refs"
    outdir         = "${projectDir}/tests/stub/work/results"
    publish_dir_mode = 'copy'

    max_cpus       = 2
    max_memory     = '4.GB'
    max_time       = '1.h'
}

workDir = "${projectDir}/tests/stub/work/nf-work"
