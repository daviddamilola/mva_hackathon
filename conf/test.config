/*
 * Stub/test profile: synthetic inputs only, no subject data, no downloads.
 * Run from tests/stub so the stub keeps its own .nextflow session history:
 *     cd tests/stub && nextflow run ../.. -profile stub -stub-run
 * Launching the stub from the repo root makes a later bare `-resume` pick up the stub session
 * instead of the real one (this happened once; see docs/03). Real runs: resume by session ID.
 */

params {
    sample_id      = 'SYNTHETIC'
    vcf            = "${projectDir}/tests/stub/synthetic_contigs.header"
    lanes          = "${projectDir}/tests/stub/lanes.csv"
    vcf_tbi        = "${projectDir}/tests/stub/synthetic_contigs.header.tbi"
    vep_cache_dir  = "${projectDir}/tests/stub/vep_cache_placeholder"
    ref_mask_bed   = "${projectDir}/assets/grch38_grc_exclusions_v2_inferred.bed"
    reference_dir  = "${projectDir}/tests/stub/work/refs"
    outdir         = "${projectDir}/tests/stub/work/results"
    publish_dir_mode = 'copy'

    max_cpus       = 2
    max_memory     = '4.GB'
    max_time       = '1.h'
}

workDir = "${projectDir}/tests/stub/work/nf-work"
