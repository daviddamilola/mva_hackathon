/*
 * Per-module publishing and arguments.
 */

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'PREPARE_FASTA|SAMTOOLS_FAIDX_DICT|BWA_INDEX' {
        publishDir = [
            path: { params.reference_dir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECK_CONTIGS' {
        publishDir = [
            path: { "${params.outdir}/qc/reference" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FETCH_ALIGN_LANE' {
        maxForks   = params.max_parallel_lanes
        publishDir = [
            path: { "${params.outdir}/alignment/lanes" },
            mode: 'copy',
            pattern: '*.{sha256.tsv,log}'
        ]
    }

    withName: 'MERGE_MARKDUP' {
        ext.args   = { "-d ${params.optical_dup_distance}" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VALIDATE_CRAM_REF' {
        publishDir = [ path: { "${params.outdir}/qc/reference" }, mode: 'copy', pattern: '*.json' ]
    }
    withName: 'PHARMCAT_SITES|PHARMCAT_REFERENCE' {
        publishDir = [ enabled: false ]
    }
    withName: 'PGX_FORCE_CALL' {
        publishDir = [ path: { "${params.outdir}/pgx/forcecall" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'ALDY_GENOTYPE' {
        maxForks   = params.max_parallel_aldy
        publishDir = [ path: { "${params.outdir}/pgx/aldy" }, mode: 'copy', pattern: '*.{aldy,log}' ]
    }
    withName: 'ALDY_PARSE|PHARMCAT_RUN' {
        publishDir = [ path: { "${params.outdir}/pgx/${task.process.tokenize(':')[-1] == 'ALDY_PARSE' ? 'aldy' : 'pharmcat'}" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PGX_RECONCILE' {
        publishDir = [ path: { "${params.outdir}/pgx" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'RESOLVE_CANDIDATES' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets" }, mode: 'copy',
                       pattern: '*.track2.{resolved.tsv,anti_target.tsv,candidates.json}' ]
    }
    withName: 'OT_META|OT_DRUG|OT_GENES' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets/raw" }, mode: 'copy', pattern: '*.json' ]
    }
    withName: 'OT_SITES|FORCE_CALL_POSITIONS' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets/forcecall" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PGX_JOIN' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'PYPGX_PREPARE' {
        publishDir = [ enabled: false ]
    }
    withName: 'PYPGX_GENOTYPE' {
        maxForks   = params.max_parallel_pypgx
        publishDir = [ path: { "${params.outdir}/pgx/pypgx" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'STAR_ALLELE_COMPARE' {
        publishDir = [ path: { "${params.outdir}/pgx" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'PANEL_VARIANTS|GNOMAD_PANEL|ALPHAMISSENSE_PANEL|SPLICEAI' {
        publishDir = [ path: { "${params.outdir}/modifier_panel/intermediate" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'VEP_ANNOTATE|MODIFIER_REPORT' {
        publishDir = [ path: { "${params.outdir}/modifier_panel" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'BIN_ANNOTATE|MOSDEPTH_BINS|MOSDEPTH_EXONS' {
        publishDir = [ path: { "${params.outdir}/aneuploidy/intermediate" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'ANEUPLOIDY_MODEL' {
        publishDir = [ path: { "${params.outdir}/aneuploidy" }, mode: 'copy',
                       saveAs: { filename -> (filename.equals('versions.yml') || filename.equals('bins_with_depth.tsv')) ? null : filename } ]
    }
    withName: 'DELLY_CALL|GENE_CN|CN_CANDIDATE_CHECK' {
        publishDir = [ path: { "${params.outdir}/panel_cnv_sv" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'READTHROUGH_ANALYSIS' {
        publishDir = [ path: { "${params.outdir}/modifier_panel" }, mode: 'copy', pattern: '*.readthrough.*' ]
    }
    withName: 'VARIANT_MECHANISM' {
        publishDir = [ path: { "${params.outdir}/modifier_panel" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PGX_LOCUS_DEPTH' {
        publishDir = [ path: { "${params.outdir}/pgx" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: 'REPORT_FIGURES' {
        // the PNGs reach results/report/figures through REPORT; only the manifest is published here
        publishDir = [ path: { "${params.outdir}/report" }, mode: 'copy', pattern: 'figures/*.figures.json',
                       saveAs: { filename -> filename.tokenize('/')[-1] } ]
    }
    withName: 'MT_RNR1_CALL|PHARMCAT_COUNTERFACTUAL' {
        publishDir = [ path: { "${params.outdir}/pgx/${task.process.tokenize(':')[-1] == 'MT_RNR1_CALL' ? 'mt_rnr1' : 'counterfactual'}" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'HLA_READS' {
        publishDir = [ enabled: false ]
    }
    withName: 'T1K_RUN|OPTITYPE_RUN|HLA_RECONCILE' {
        publishDir = [ path: { "${params.outdir}/pgx/hla" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'SOMALIER|VERIFYBAMID2|BCFTOOLS_ROH|SAMTOOLS_STATS|BCFTOOLS_STATS|QC_SUMMARY' {
        publishDir = [ path: { "${params.outdir}/qc" }, mode: 'copy',
                       saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.somalier')) ? null : filename } ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PROVENANCE' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: 'copy' ]
    }
    withName: 'REPORT' {
        publishDir = [ path: { "${params.outdir}/report" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
}
