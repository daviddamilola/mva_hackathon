/*
 * Per-module publishing and arguments.
 */

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'PREPARE_FASTA|SAMTOOLS_FAIDX_DICT|BWA_INDEX' {
        publishDir = [
            path: { params.reference_dir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECK_CONTIGS' {
        publishDir = [
            path: { "${params.outdir}/qc/reference" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FETCH_ALIGN_LANE' {
        maxForks   = params.max_parallel_lanes
        publishDir = [
            path: { "${params.outdir}/alignment/lanes" },
            mode: 'copy',
            pattern: '*.{sha256.tsv,log}'
        ]
    }

    withName: 'MERGE_MARKDUP' {
        ext.args   = { "-d ${params.optical_dup_distance}" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VALIDATE_CRAM_REF' {
        publishDir = [ path: { "${params.outdir}/qc/reference" }, mode: 'copy', pattern: '*.json' ]
    }
    withName: 'PHARMCAT_SITES|PHARMCAT_REFERENCE' {
        publishDir = [ enabled: false ]
    }
    withName: 'PGX_FORCE_CALL' {
        publishDir = [ path: { "${params.outdir}/pgx/forcecall" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'ALDY_GENOTYPE' {
        maxForks   = params.max_parallel_aldy
        publishDir = [ path: { "${params.outdir}/pgx/aldy" }, mode: 'copy', pattern: '*.{aldy,log}' ]
    }
    withName: 'ALDY_PARSE|PHARMCAT_RUN' {
        publishDir = [ path: { "${params.outdir}/pgx/${task.process.tokenize(':')[-1] == 'ALDY_PARSE' ? 'aldy' : 'pharmcat'}" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PGX_RECONCILE' {
        publishDir = [ path: { "${params.outdir}/pgx" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }

    withName: 'OT_META|OT_DRUG|OT_GENES' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets/raw" }, mode: 'copy', pattern: '*.json' ]
    }
    withName: 'OT_SITES|FORCE_CALL_POSITIONS' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets/forcecall" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
    withName: 'PGX_JOIN' {
        publishDir = [ path: { "${params.outdir}/pgx/open_targets" }, mode: 'copy',
                       saveAs: { filename -> filename.equals('versions.yml') ? null : filename } ]
    }
}
