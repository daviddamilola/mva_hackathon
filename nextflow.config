/*
 * mva-track2 — VCF/CRAM-derived analyses for MVA Hackathon 2026, Track 2.
 * Subject data is controlled-access (DUA): inputs live in data/, outputs in results/,
 * both gitignored.
 */

manifest {
    name            = 'mva-track2'
    description     = 'Pharmacogenomics, modifier genotypes, mosaic aneuploidy burden and genome QC for one MVA proband'
    author          = 'David Oluwasusi'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0dev'
}

params {
    // Input
    sample_id              = 'WGS_EX2312012'
    vcf                    = "${projectDir}/data/WGS_EX2312012_HGWCNDSX7.vcf.gz"
    lanes                  = "${projectDir}/assets/lanes.csv"
    hf_repo                = 'SageBio/mva-hackathon-2026-data'
    hf_repo_type           = 'dataset'

    // Reference: rebuilt to match the VCF header (see docs/00_data_inspection.md)
    genome                 = 'GRCh38'
    ref_name               = 'GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set_maskedGRC_exclusions_v2_no_chr'
    ref_fasta_url          = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set.fna.gz'
    ref_fasta_md5          = 'a056c57649f3c9964c68aead3849bbf8'
    ref_mask_bed           = "${projectDir}/assets/grch38_grc_exclusions_v2_inferred.bed"
    reference_dir          = "${projectDir}/refs"

    // Alignment
    skip_alignment         = false
    max_parallel_lanes     = 1      // each lane downloads ~21 GB of FASTQ; keep at 1 on small disks
    optical_dup_distance   = 2500   // patterned flowcell (NovaSeq)

    // Existing CRAM (optional; otherwise produced by the alignment branch)
    cram                   = null
    crai                   = null
    // XY inferred in docs/00 (chrX non-PAR het fraction 0.012, 13.8k chrY calls). Sets chrX
    // ploidy for force-calling (G6PD hemizygous). The QC branch re-checks it from coverage.
    sample_sex             = 'M'

    // Pharmacogenomics, stage 1a
    skip_pgx                  = false
    aldy_genes                = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,CYP4F2,TPMT,NUDT15,DPYD,UGT1A1,SLCO1B1,G6PD,VKORC1,ABCG2,RYR1,CACNA1S,IFNL3'
    aldy_profile              = 'wgs'
    pgx_genes                 = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,CYP4F2,TPMT,NUDT15,DPYD,UGT1A1,SLCO1B1,G6PD,VKORC1,ABCG2,RYR1,CACNA1S,IFNL3,HLA-A,HLA-B'
    pgx_outside_call_genes    = 'CYP2D6'   // Aldy calls passed to PharmCAT (PharmCAT cannot call these from VCF)
    pharmcat_reporter_sources = 'CPIC,DPWG,FDA'
    max_parallel_aldy         = 3

    // Pharmacogenomics, stage 1b (pgx_annotate.nf)
    drugs                     = null     // list of ChEMBL IDs (params file) or comma-separated string
    pgx_calls_json            = null     // defaults to <outdir>/pgx/<sample>.pgx_calls.json
    pharmcat_report           = null     // defaults to <outdir>/pgx/pharmcat/<sample>.report.json
    pgx_forcecall_vcf         = null     // defaults to <outdir>/pgx/forcecall/<sample>.pgx_forcecall.vcf.gz
    ot_assert_levels          = '1A,1B'  // only these levels contribute to verdicts; level 3 is counted as exploratory
    ot_include_direct_targets = false    // metaboliser panel: rows where the gene is the drug's target are excluded (counted)

    // Analysis parameters (used by later subworkflows)
    gene_panel_bed         = "${projectDir}/assets/mechanistic_panel_grch38.bed"
    bin_size               = 100000

    // Output
    outdir                 = "${projectDir}/results"
    publish_dir_mode       = 'link' // hard links: no duplicate copies of multi-GB files

    // Resource ceilings
    max_cpus               = 8
    max_memory             = '14.GB'
    max_time               = '48.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        // If the launching shell has conda 'base' active, activating a task env replaces base's
        // PATH entry in place, so e.g. /opt/homebrew/bin/samtools shadows the pinned env binary.
        // Clearing the inherited state makes activation prepend the env instead.
        process.beforeScript   = 'unset CONDA_SHLVL CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER'
        docker.enabled         = false
        singularity.enabled    = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) -e HF_TOKEN'
        conda.enabled          = false
        singularity.enabled    = false
        // modules without a single-tool biocontainer are built from their pinned environment.yml
        wave.enabled           = true
        wave.strategy          = ['container', 'conda']
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.envWhitelist = 'HF_TOKEN'
        conda.enabled          = false
        docker.enabled         = false
        wave.enabled           = true
        wave.strategy          = ['container', 'conda']
    }
    test {
        includeConfig 'conf/test.config'
    }
    stub {
        includeConfig 'conf/test.config'
    }
}

env {
    HF_HUB_DISABLE_TELEMETRY       = '1'
    HF_XET_CHUNK_CACHE_SIZE_BYTES  = '0'   // no hidden multi-GB chunk cache in ~/.cache
    PYTHONNOUSERSITE               = '1'
}

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html" }
