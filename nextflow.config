/*
 * mva-track2 — VCF/CRAM-derived analyses for MVA Hackathon 2026, Track 2.
 * Subject data is controlled-access (DUA): inputs live in data/, outputs in results/,
 * both gitignored.
 */

manifest {
    name            = 'mva-track2'
    description     = 'Pharmacogenomics, modifier genotypes, mosaic aneuploidy burden and genome QC for one MVA proband'
    author          = 'David Oluwasusi'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0dev'
}

params {
    // Input
    sample_id              = 'WGS_EX2312012'
    vcf                    = "${projectDir}/data/WGS_EX2312012_HGWCNDSX7.vcf.gz"
    lanes                  = "${projectDir}/assets/lanes.csv"
    hf_repo                = 'SageBio/mva-hackathon-2026-data'
    hf_repo_type           = 'dataset'

    // Reference: rebuilt to match the VCF header (see docs/00_data_inspection.md)
    genome                 = 'GRCh38'
    ref_name               = 'GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set_maskedGRC_exclusions_v2_no_chr'
    ref_fasta_url          = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_plus_hs38d1_analysis_set.fna.gz'
    ref_fasta_md5          = 'a056c57649f3c9964c68aead3849bbf8'
    ref_mask_bed           = "${projectDir}/assets/grch38_grc_exclusions_v2_inferred.bed"
    reference_dir          = "${projectDir}/refs"

    // Alignment
    skip_alignment         = false
    max_parallel_lanes     = 1      // each lane downloads ~21 GB of FASTQ; keep at 1 on small disks
    optical_dup_distance   = 2500   // patterned flowcell (NovaSeq)

    // Existing CRAM (optional; otherwise produced by the alignment branch)
    cram                   = null
    crai                   = null
    // XY inferred in docs/00 (chrX non-PAR het fraction 0.012, 13.8k chrY calls). Sets chrX
    // ploidy for force-calling (G6PD hemizygous). The QC branch re-checks it from coverage.
    sample_sex             = 'M'

    // Pharmacogenomics, stage 1a
    skip_pgx                  = false
    aldy_genes                = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,CYP4F2,TPMT,NUDT15,DPYD,UGT1A1,SLCO1B1,G6PD,VKORC1,ABCG2,RYR1,CACNA1S,IFNL3'
    aldy_profile              = 'wgs'
    pgx_genes                 = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,CYP4F2,TPMT,NUDT15,DPYD,UGT1A1,SLCO1B1,G6PD,VKORC1,ABCG2,RYR1,CACNA1S,IFNL3,HLA-A,HLA-B'
    pgx_outside_call_genes    = 'CYP2D6'   // Aldy calls passed to PharmCAT (PharmCAT cannot call these from VCF)
    pharmcat_reporter_sources = 'CPIC,DPWG,FDA'
    max_parallel_aldy         = 3
    // second star-allele caller (PyPGx = Stargazer's maintained successor), parallel to Aldy
    skip_pypgx                = false
    pypgx_genes               = 'CYP2D6,CYP2C19,CYP2C9,CYP2B6,CYP3A5,CYP4F2,TPMT,NUDT15,DPYD,UGT1A1,SLCO1B1,G6PD,VKORC1,ABCG2,RYR1,CACNA1S,IFNL3'
    pypgx_control_gene        = 'VDR'
    pypgx_bundle_version      = '0.27.0'
    pypgx_bundle_sha256       = 'a0ebcdf3f90264f3b6dc743ddd77e557c9aa305bb7636aa81464db0787bef8c6'
    max_parallel_pypgx        = 3
    // HLA typing (T1K + OptiType); concordant 2-field HLA-A/B -> PharmCAT outside calls
    skip_hla                  = false
    hla_region                = '6:28510120-33480577'     // GRCh38 MHC
    hla_pharmcat_genes        = 'HLA-A,HLA-B'
    imgt_hla_version          = '3.65.0'
    imgt_hla_dat_url          = 'https://github.com/ANHIG/IMGTHLA/raw/5b915f27f7f620361cf83cb626eeac8a03c0247c/hla.dat.zip'
    imgt_hla_dat_sha256       = '01aa70fed700cd3dc6e59a800ee2479582d0ac35e5e27df39b5db42ae54a1668'

    // Pharmacogenomics, stage 1b (pgx_annotate.nf)
    drugs                     = null     // list of ChEMBL IDs (params file) or comma-separated string
    pgx_calls_json            = null     // defaults to <outdir>/pgx/<sample>.pgx_calls.json
    pharmcat_report           = null     // defaults to <outdir>/pgx/pharmcat/<sample>.report.json
    pgx_forcecall_vcf         = null     // defaults to <outdir>/pgx/forcecall/<sample>.pgx_forcecall.vcf.gz
    ot_assert_levels          = '1A,1B'  // only these levels contribute to verdicts; level 3 is counted as exploratory
    ot_include_direct_targets = false    // metaboliser panel: rows where the gene is the drug's target are excluded (counted)

    // Analysis 2: modifier panel
    skip_modifier_panel    = false
    vcf_tbi                = null
    gene_panel_bed         = "${projectDir}/assets/mechanistic_panel_grch38.bed"   // Ensembl 116, +/-10 kb (bin/make_panel_bed.py)
    vep_cache_dir          = "${projectDir}/refs/vep"
    vep_cache_version      = 116
    gnomad_version         = '4.1'
    gnomad_base_url        = 'https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/joint'
    gnomad_fields          = 'AF_joint,AC_joint,AN_joint,nhomalt_joint,AF_grpmax_joint,grpmax_joint,fafmax_faf95_max_joint,AF_joint_afr,AF_joint_amr,AF_joint_asj,AF_joint_eas,AF_joint_fin,AF_joint_mid,AF_joint_nfe,AF_joint_sas,AF_joint_remaining,exomes_filters,genomes_filters'
    clinvar_release        = '20260923'
    alphamissense_url      = 'https://storage.googleapis.com/dm_alphamissense/AlphaMissense_hg38.tsv.gz'
    alphamissense_md5_b64  = 'n9Fnc18Wobh9pus+TCX8tQ=='
    spliceai_annotation    = "${projectDir}/assets/spliceai_panel_mane_ensembl116.txt"   // bin/make_spliceai_annotation.py
    spliceai_distance      = 50
    spliceai_mask          = 1
    spliceai_min_delta     = 0.2
    panel_max_af           = 0.01

    // Analysis 3: mosaic aneuploidy burden + panel CNV/SV
    skip_aneuploidy        = false
    bin_size               = 100000
    mosdepth_mapq          = 20
    aneuploidy_min_map     = 0.9
    delly_min_mapq         = 20
    umap_url               = 'https://bismap.hoffmanlab.org/raw/hg38/k100.umap.bed.gz'   // longest k published; conservative for 150 bp reads
    umap_sha256            = '063c02b0d50334b43f358688b0573a2961480ddc697b13603674620a60b15fd0'
    blacklist_url          = 'https://raw.githubusercontent.com/Boyle-Lab/Blacklist/d0527cdea356bf57d30535b48783804ca8d21031/lists/hg38-blacklist.v2.bed.gz'
    blacklist_sha256       = 'c92e763af17271446194991e71917ac220593a5a3d40a06667be24178ef08cf2'
    cytoband_url           = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/cytoBand.txt.gz'
    cytoband_sha256        = 'e514e48b0a12a516fd5231b44241a20a282f290bdd6131cadcddc6276ee26082'
    delly_exclude_url      = 'https://raw.githubusercontent.com/dellytools/delly/72a05f3cd23bf55f1edd723b9504a0faf1fba230/excludeTemplates/human.hg38.excl.tsv'
    delly_exclude_sha256   = 'caef8593f82f513694ae41b429680eab8abe39c057a119dae7760715aef006ee'
    segdup_url             = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/genomicSuperDups.txt.gz'
    segdup_sha256          = '3f4388ed3eb7462034e89c1f45314160bdb14558502092326063105c095061df'


    // Output
    outdir                 = "${projectDir}/results"
    publish_dir_mode       = 'link' // hard links: no duplicate copies of multi-GB files

    // Resource ceilings
    max_cpus               = 8
    max_memory             = '14.GB'
    max_time               = '48.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    conda {
        conda.enabled          = true
        conda.channels         = ['conda-forge', 'bioconda']
        // If the launching shell has conda 'base' active, activating a task env replaces base's
        // PATH entry in place, so e.g. /opt/homebrew/bin/samtools shadows the pinned env binary.
        // Clearing the inherited state makes activation prepend the env instead.
        process.beforeScript   = 'unset CONDA_SHLVL CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER'
        docker.enabled         = false
        singularity.enabled    = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) -e HF_TOKEN'
        conda.enabled          = false
        singularity.enabled    = false
        // modules without a single-tool biocontainer are built from their pinned environment.yml
        wave.enabled           = true
        wave.strategy          = ['container', 'conda']
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.envWhitelist = 'HF_TOKEN'
        conda.enabled          = false
        docker.enabled         = false
        wave.enabled           = true
        wave.strategy          = ['container', 'conda']
    }
    // Apple Silicon: use together with conda:  -profile conda,macos_docker
    // Two tools have broken osx-arm64 conda builds, so only they run in native linux/arm64 containers;
    // every other process keeps running natively under conda.
    //  - VEP 116.2: conda perl 5.32.1 segfaults in DB_File at load -> official Ensembl image, pinned by digest
    //  - Delly 2.6.0: SIGBUS decoding CRAM (BAM works) -> image built from containers/delly (pinned base
    //    digest + bioconda linux-aarch64 packages):  docker build -t mva-track2/delly:2.6.0 containers/delly
    macos_docker {
        includeConfig 'conf/macos_docker.config'
    }
    vep_docker {   // deprecated alias kept so earlier commands still work
        includeConfig 'conf/macos_docker.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    stub {
        includeConfig 'conf/test.config'
    }
}

env {
    HF_HUB_DISABLE_TELEMETRY       = '1'
    HF_XET_CHUNK_CACHE_SIZE_BYTES  = '0'   // no hidden multi-GB chunk cache in ~/.cache
    PYTHONNOUSERSITE               = '1'
}

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html" }
